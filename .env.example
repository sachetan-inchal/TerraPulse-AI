# TerraPulse AIR - Environment Configuration Example

# OpenAQ API v3 Key (https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# Google Gemini API Key & Model (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Local Ollama Configuration (IBM Granite or compatible model)
OLLAMA_MODEL=granite4.2:3b
OLLAMA_HOST=http://localhost:11434

# Persistence Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=terrapulse_air

# Server Configuration
PORT=8000
HOST=0.0.0.0

